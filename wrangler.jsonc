// 에이스렌터카 홈페이지 — Cloudflare Workers 설정
// 운영 주소: acerentcar.co.kr (www 포함). 예전 테스트 주소 onlycartalk.com 은 새 주소로 넘겨줌(LEGACY_HOSTS)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acerentcar",
  "main": "src/index.js",
  // src/pages/*.html 을 문자열로 불러옴 (로그인한 관리자에게만 Worker 가 내려줌 — public 폴더에 두지 않음)
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // 테스트용 주소 acerentcar.<계정>.workers.dev 켜기 (도메인 연결 전 확인용)
  "workers_dev": true,

  // 화면(HTML/CSS/JS)은 public 폴더 파일을 Worker 가 그대로 내려줌.
  // 모든 요청이 Worker 를 먼저 거치는 이유: 예전 주소(LEGACY_HOSTS)로 온 화면 요청도 새 주소로 넘겨주기 위해 (무료 한도 하루 10만 요청)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // DB: 예약·신청·문의·고객·게시판·설정
  // Cloudflare 대시보드에서 만든 acerentcar-db
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acerentcar-db",
      "database_id": "64a4a7be-8999-4c74-84f5-e13e89266e50",
      "migrations_dir": "migrations"
    }
  ],

  // 사진: 메인 배너, 중장기 실차 사진, 단기 차종 이미지, 문의 첨부
  // 처음 한 번: npx wrangler r2 bucket create acerentcar-images
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "acerentcar-images" }
  ],

  // 관리자 알림 메일 (Email Routing 에서 인증한 수신 주소로만 발송 — 무료)
  "send_email": [
    { "name": "MAILER" }
  ],

  // 실패한 알림 메일 자동 재발송 (10분마다, 최대 3회)
  "triggers": { "crons": ["*/10 * * * *"] },

  "vars": {
    "SITE_NAME": "에이스렌터카",
    "SITE_URL": "https://acerentcar.co.kr",
    // 이 주소로 들어오면 SITE_URL 의 같은 경로로 넘겨줌 (Worker 에 사용자 지정 도메인으로 계속 붙여 둘 것)
    "LEGACY_HOSTS": "onlycartalk.com,www.onlycartalk.com",
    // 보내는 주소: Email Routing 을 켠 도메인의 주소여야 함.
    // acerentcar.co.kr 에는 Email Routing 을 켜지 말 것 — MX 가 바뀌어 다우오피스 회사 메일이 끊김. 알림 발신은 onlycartalk.com 그대로 사용
    "MAIL_FROM": "noti@onlycartalk.com",
    "MAIL_FROM_NAME": "에이스렌터카 홈페이지",
    // rentcarerp 연동: 비워두면 관리자 화면의 '단기 차량(임시)' 목록으로 동작
    "ERP_API_BASE": "https://rentcarerp.com"
  },
  // 비밀값(대시보드 또는 wrangler secret put 으로 등록):
  //   ERP_API_KEY   — rentcarerp 연동 키
  //   SESSION_SECRET — 관리자 로그인 서명용 임의 문자열 (32자 이상)

  "observability": { "enabled": true }
}
