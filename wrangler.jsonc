// 에이스렌터카 홈페이지 — Cloudflare Workers 설정
// 운영: acerentcar.co.kr (2026-11-10 전환, 테스트는 onlycartalk.com 에서 했음)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acerentcar",
  "main": "src/index.js",
  // src/pages/*.html 을 문자열로 불러옴 (로그인한 관리자에게만 Worker 가 내려줌 — public 폴더에 두지 않음)
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // 테스트용 주소 acerentcar.<계정>.workers.dev 켜기 (도메인 연결 전 확인용)
  "workers_dev": true,

  // 화면(HTML/CSS/JS)은 public 폴더에서 바로 제공하고, /api 와 /img 만 Worker 코드가 처리
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/img/*", "/admin/quote", "/admin/quote/", "/robots.txt", "/sitemap.xml", "/bbs/*", "/html/*", "/adm/*", "/theme/*", "/*.php"]
  },

  // DB: 예약·신청·문의·고객·게시판·설정
  // Cloudflare 대시보드에서 만든 acerentcar-db
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acerentcar-db",
      "database_id": "64a4a7be-8999-4c74-84f5-e13e89266e50",
      "migrations_dir": "migrations"
    }
  ],

  // 사진: 메인 배너, 중장기 실차 사진, 단기 차종 이미지, 문의 첨부
  // 처음 한 번: npx wrangler r2 bucket create acerentcar-images
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "acerentcar-images" }
  ],

  // 관리자 알림 메일 (Email Routing 에서 인증한 수신 주소로만 발송 — 무료)
  "send_email": [
    { "name": "MAILER" }
  ],

  // 실패한 알림 메일 자동 재발송 (10분마다, 최대 3회)
  "triggers": { "crons": ["*/10 * * * *"] },

  "vars": {
    "SITE_NAME": "에이스렌터카",
    "SITE_URL": "https://acerentcar.co.kr",
    // 보내는 주소: Email Routing 을 켠 도메인의 주소여야 함 — acerentcar.co.kr 은 다우오피스 메일(MX)이 있어 Email Routing 을 켜지 않고 onlycartalk.com 주소로 보냄
    "MAIL_FROM": "noti@onlycartalk.com",
    "MAIL_FROM_NAME": "에이스렌터카 홈페이지",
    // rentcarerp 연동: 비워두면 관리자 화면의 '단기 차량(임시)' 목록으로 동작
    "ERP_API_BASE": "https://rentcarerp.com",
    // 게시판 광고 차단 — 비워두면 꺼진 채로 동작 (src/lib/guard.js)
    //   Turnstile 사람 확인: 대시보드 Turnstile 에서 위젯을 만들고 사이트 키를 여기에, 비밀 키는 TURNSTILE_SECRET 비밀값으로
    "TURNSTILE_SITE_KEY": "",
    //   문자 인증: 솔라피 가입 후 'solapi', 등록한 발신번호 (API 키 · 시크릿은 SMS_API_KEY · SMS_API_SECRET 비밀값으로)
    "SMS_PROVIDER": "",
    "SMS_FROM": ""
  },
  // 비밀값(대시보드 또는 wrangler secret put 으로 등록):
  //   ERP_API_KEY   — rentcarerp 연동 키
  //   TURNSTILE_SECRET · SMS_API_KEY · SMS_API_SECRET — 위 광고 차단 설정용
  //   SESSION_SECRET — 관리자 로그인 서명용 임의 문자열 (32자 이상)

  "observability": { "enabled": true }
}
